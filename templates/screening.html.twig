{% extends 'base.html.twig' %}

{% block title %}
    Выбор мест —
    {{ screening.movie.title }}
{% endblock %}

{% block body %}
    <h1>
        {{ screening.movie.title }}
    </h1>
    <p>
        {{ screening.hall.name }}
        —
        {{ screening.startAt|date('d.m.Y H:i') }}
    </p>

    {% if app.user %}
        <h2>
        Выберите места
    </h2>
        <form action="{{ path('booking_create', {id: screening.id}) }}" method="post">
            <div class="seat-map">
                {% for seat in seats %}
                    {% set isBooked = seat.id in takenSeatId %}
                    <label class="seat {{ isBooked ? 'seat-booked' : '' }}">
                        <input type="checkbox" name="seats[]" value="{{ seat.id }}" {{ isBooked ? 'disabled' : '' }}>
                            Ряд
                            {{ seat.rowNumber }}
                            , место
                            {{ seat.seatNumber }}
                            .
                            {% if seat.seatType == 'vip' %}
                                (VIP)
                            {% endif %}
                        </label>
                    {% endfor %}
                </div>
                <button type="submit">
                    Оформить заказ
                </button>
            </form>
        {% else %}
            <h4>
                Для оформления билета вы должны быть авторизованы. Пожалуйста зайдте в свой аккаунт или зарегистрируйтесь
            </h4>
            <a href="{{ path('app_login') }}">
                Войти
            </a>
            <a href="{{ path('app_register') }}">
                Регистрация
            </a>
        {% endif %}

    {% endblock %}
    